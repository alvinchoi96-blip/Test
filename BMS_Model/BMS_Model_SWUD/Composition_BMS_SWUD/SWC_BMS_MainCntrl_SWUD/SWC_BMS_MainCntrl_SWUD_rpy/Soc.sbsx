						<_modifiedTimeWeak type="a">1.2.1990::0:0:0</_modifiedTimeWeak>
						<_modifiedTime type="a">1.1.1970::9:0:0</_modifiedTime>
						<_body type="a">const uint32 packVoltageSum = g_Input_CellMeas.packVoltageSum;%0D
const sint32 packCurrent    = g_Input_CurrMeas.packCurrent;%0D
const sint16 packTemp       = g_Input_TempMeas.cellTempAverage;%0D
const uint8 ignOn           = (g_Input_Signal.ignSignal != 0u) ? 1u : 0u;%0D
(g_Input_Signal.ignSignal != 0u) ? 1u : 0u;%0D
const uint8 chgConnected    = (g_Input_Signal.chargeConnectedFlag != 0u) ? 1u : 0u;%0D
(g_Input_Signal.chargeConnectedFlag != 0u) ? 1u : 0u;%0D
inputValid = BmsSoc_Estimator_CheckInputValid((uint16)packVoltageSum, (sint16)packCurrent, packTemp);%0D
BmsSoc_State_OnInputs((uint16)packVoltageSum, (sint16)packCurrent, packTemp, ignOn, chgConnected, inputValid);%0D
deltaSocCc_x10 = BmsSoc_Estimator_CalcDeltaSocCc_x10((sint16)packCurrent);%0D
BmsSoc_State_ApplyCcDelta(deltaSocCc_x10);</_body>
					</IAction>
					</_entryAction>
				</IState>
