						<_body type="a">const uint16 s0 = BmsSoc_OcvSocBp_X10[i];%0D
const uint16 s1 = BmsSoc_OcvSocBp_X10[i + 1u];%0D
const uint16 dv = (uint16)(v1 - v0);%0D
const uint16 dx = (uint16)(packVoltage_mV - v0);</_body>
