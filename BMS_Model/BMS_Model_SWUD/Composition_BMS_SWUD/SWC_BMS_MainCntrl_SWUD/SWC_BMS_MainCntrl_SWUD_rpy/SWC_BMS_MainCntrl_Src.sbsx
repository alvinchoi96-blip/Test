						<_modifiedTimeWeak type="a">1.2.1990::0:0:0</_modifiedTimeWeak>
						<_modifiedTime type="a">1.1.1970::9:0:0</_modifiedTime>
						<_body type="a">ret = Rte_Read_R_CellMeasData_packVoltageSum(&amp;packVoltageSum_u32);%0D
ret = Rte_Read_R_CurrMeasData_packCurrent(&amp;packCurrent_s32);%0D
ret = Rte_Read_R_TempMeasData_cellTempAverage(&amp;cellTempAvg_s16);%0D
ret = Rte_Read_R_SignalInput_ignSignal(&amp;ignSignal);%0D
ret = Rte_Read_R_SignalInput_chargeConnectedFlag(&amp;chgConnectedFlag);%0D
in.packVoltage_mV  = Bms_ClampU32ToU16(packVoltageSum_u32);%0D
in.packCurrent_mA  = Bms_ClampS32ToS16(packCurrent_s32);%0D
in.packTemp_dC     = cellTempAvg_s16;%0D
in.ignOn           = (ignSignal != (e_IgnStat)0) ? (uint8)1u : (uint8)0u;%0D
(ignSignal != (e_IgnStat)0) ? (uint8)1u : (uint8)0u;%0D
in.chgConnected    = (chgConnectedFlag != (boolean)0) ? (uint8)1u : (uint8)0u;%0D
(chgConnectedFlag != (boolean)0) ? (uint8)1u : (uint8)0u;%0D
BmsMainCntrl_Soc_Process_1000ms(&amp;in, &amp;out);%0D
Rte_Write_P_PackCalculatedData_Tx_socLevel(out.soc_x10);%0D
Rte_Write_P_PackCalculatedData_Tx_sohLevel((uint32)out.soh_x10);%0D
Rte_Write_P_HMI_SigOutput_socGauge((uint8)(out.soc_x10 / 10u));</_body>
